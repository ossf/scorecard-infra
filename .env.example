#
# Copy to .env and fill in before running `docker compose up`.
# docker compose loads .env from the project directory automatically.

# Required for live scans (cache HITs are served without it).
# `gh auth token` will print a working value if you have the gh CLI.
GITHUB_AUTH_TOKEN=

# debug | info | warn | error
SCORECARD_LOG_LEVEL=info
