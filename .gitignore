/scorecard-api
.env

# Docker Compose bind mount for the results API server's local store
# (cmd/scorecard-api/docker-compose.yml).
/cmd/scorecard-api/data/

# Results API build artifact. Upstream ignored this as `scorecard-webapp` at its
# repository root; the binary name is unchanged through cutover (design W5).
/api/scorecard-webapp

# Batch pipeline build artifacts (see Makefile "Pipeline binaries")
/cron/internal/bq/data-transfer
/cron/internal/cii/cii-worker
/cron/internal/controller/controller
/cron/internal/data/add/add
/cron/internal/data/validate/validate
/cron/internal/githubserver/github-auth-server
/cron/internal/shuffle/shuffle
/cron/internal/webhook/webhook
/cron/internal/worker/worker

# Captured deployment configuration (scripts/cutover/capture-config.sh). Not in
# git by design: it describes live infrastructure and may contain values the
# redaction pass did not recognize.
/scripts/cutover/out/

# OpenTofu working state (deploy/). Provider plugin binaries under .terraform/
# are machine-local; state belongs in the S3 backend, and a *.tfstate in a
# working tree means a root module ran without its backend configured.
# *.tfvars may carry real values -- the checked-in examples are
# *.tfvars.example. .terraform.lock.hcl is NOT ignored here: it is the
# provider-version lock for each root module and stays tracked on purpose.
# tfplan is `tofu plan -out=`'s saved plan file -- a point-in-time snapshot of
# real resource attributes, stale the moment the next apply runs anywhere.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
crash.log
crash.*.log
